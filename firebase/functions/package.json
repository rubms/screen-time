{
  "name": "@screen-time-control/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "SKIP_RULES_TESTS=1 SKIP_EMULATOR_TESTS=1 vitest run",
    "test:unit": "vitest run test/rollup.unit.test.ts",
    "test:rules": "vitest run test/firestore.rules.test.ts",
    "test:integration": "vitest run test/emulator.integration.test.ts",
    "test:emulators": "firebase emulators:exec --project demo-screen-time --only firestore,auth \"npm run test:rules && npm run test:integration\"",
    "test:watch": "vitest",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "firebase": "^11.8.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
